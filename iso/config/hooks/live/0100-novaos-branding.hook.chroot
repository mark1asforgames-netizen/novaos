#!/bin/sh
# Runs inside the image chroot after packages are installed.
set -e
# Keep ID=debian so tools that depend on it keep working; only the display name changes.
if [ -f /usr/lib/os-release ]; then
    sed -i 's|^PRETTY_NAME=.*|PRETTY_NAME="NovaOS (based on Debian GNU/Linux 13)"|' /usr/lib/os-release
    grep -q '^VARIANT=' /usr/lib/os-release || echo 'VARIANT="NovaOS"' >> /usr/lib/os-release
fi
echo "NovaOS based on Debian GNU/Linux 13 (trixie)" > /etc/issue.net
printf 'NovaOS \\n \\l\n\n' > /etc/issue
